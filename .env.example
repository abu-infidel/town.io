# ==== Copy this file to .env and fill in real values before `docker compose up` ====

# --- General ---
NODE_ENV=production
PUBLIC_DOMAIN=example-town.ir
# Used for cookie signing / session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=changeme-generate-a-long-random-hex-string

# --- Postgres ---
POSTGRES_USER=mahalle
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=mahalle
DATABASE_URL=postgresql://mahalle:changeme-strong-password@postgres:5432/mahalle

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- SMS OTP provider ---
# Leave SMS_PROVIDER=console during setup/testing: OTP codes are printed to the
# api container logs instead of being sent, so you can test the whole flow
# before you have a real gateway account.
SMS_PROVIDER=console
# When ready, set SMS_PROVIDER=kavenegar and fill these in:
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=mahalle-otp

# --- Moderation (LLM-assisted) ---
# Leave MODERATION_PROVIDER=none to send everything straight to the human queue.
MODERATION_PROVIDER=none
ANTHROPIC_API_KEY=

# --- Payments (ads / donations / charity) ---
# MVP: manual bank transfer + admin confirmation. Fill in your real account info.
PAYMENT_PROVIDER=manual
MANUAL_PAYMENT_CARD_NUMBER=
MANUAL_PAYMENT_SHEBA=
MANUAL_PAYMENT_OWNER_NAME=

# --- Media storage (local disk, mounted volume) ---
MEDIA_UPLOAD_DIR=/data/media/uploads
MEDIA_PROCESSED_DIR=/data/media/processed
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=200

# --- Ports (host side) ---
HTTP_PORT=80
HTTPS_PORT=443
