    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@mahalle/shared": "*",
    "@prisma/client": "^5.19.1",
    "bullmq": "^5.12.12",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "cookie": "^0.6.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "rate-limiter-flexible": "^5.0.3",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
